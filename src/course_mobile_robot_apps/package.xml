<?xml version="1.0"?>
<package format="3">
  <name>course_mobile_robot_apps</name>
  <version>1.0.0</version>
  <description>Simple autonomous cruise and goal navigation applications.</description>
  <maintainer email="teacher@example.com">ROS 2 Course Teacher</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>course_mobile_robot_sim</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <export><build_type>ament_python</build_type></export>
</package>
