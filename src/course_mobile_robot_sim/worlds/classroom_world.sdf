<?xml version="1.0"?>
<sdf version="1.9">
  <world name="classroom_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size><real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <gravity>0 0 -9.8</gravity>
    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose><cast_shadows>true</cast_shadows>
      <intensity>1.0</intensity><direction>-0.5 0.2 -1.0</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material><ambient>0.82 0.82 0.82 1</ambient><diffuse>0.82 0.82 0.82 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="red_box">
      <static>true</static><pose>2.0 0.6 0.30 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.60 0.60 0.60</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.60 0.60 0.60</size></box></geometry>
          <material><ambient>0.90 0.15 0.15 1</ambient><diffuse>0.90 0.15 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="green_box">
      <static>true</static><pose>1.4 -1.1 0.35 0 0 0.35</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.50 0.90 0.70</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.50 0.90 0.70</size></box></geometry>
          <material><ambient>0.15 0.75 0.20 1</ambient><diffuse>0.15 0.75 0.20 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="blue_box">
      <static>true</static><pose>-1.6 1.1 0.30 0 0 -0.30</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.80 0.35 0.60</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.80 0.35 0.60</size></box></geometry>
          <material><ambient>0.15 0.25 0.90 1</ambient><diffuse>0.15 0.25 0.90 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="north_wall">
      <static>true</static><pose>0 3.2 0.40 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>7.0 0.15 0.80</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>7.0 0.15 0.80</size></box></geometry>
          <material><ambient>0.45 0.45 0.45 1</ambient><diffuse>0.45 0.45 0.45 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="south_wall">
      <static>true</static><pose>0 -3.2 0.40 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>7.0 0.15 0.80</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>7.0 0.15 0.80</size></box></geometry>
          <material><ambient>0.45 0.45 0.45 1</ambient><diffuse>0.45 0.45 0.45 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="east_wall">
      <static>true</static><pose>3.5 0 0.40 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.15 6.5 0.80</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.15 6.5 0.80</size></box></geometry>
          <material><ambient>0.45 0.45 0.45 1</ambient><diffuse>0.45 0.45 0.45 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="west_wall">
      <static>true</static><pose>-3.5 0 0.40 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.15 6.5 0.80</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.15 6.5 0.80</size></box></geometry>
          <material><ambient>0.45 0.45 0.45 1</ambient><diffuse>0.45 0.45 0.45 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
