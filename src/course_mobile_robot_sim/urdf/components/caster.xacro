<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="caster" params="">
    <link name="caster_link">
      <visual>
        <geometry>
          <sphere radius="${caster_radius}"/>
        </geometry>
        <material name="caster_gray"/>
      </visual>
      <collision>
        <geometry>
          <sphere radius="${caster_radius}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.20"/>
        <inertia ixx="0.00020" ixy="0.0" ixz="0.0"
                 iyy="0.00020" iyz="0.0" izz="0.00020"/>
      </inertial>
    </link>

    <joint name="caster_joint" type="fixed">
      <parent link="base_link"/>
      <child link="caster_link"/>
      <origin xyz="${caster_x} 0 ${caster_z}" rpy="0 0 0"/>
    </joint>
  </xacro:macro>
</robot>
