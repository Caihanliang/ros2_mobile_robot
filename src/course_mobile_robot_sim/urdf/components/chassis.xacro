<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="chassis" params="">
    <link name="base_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="${base_length} ${base_width} ${base_height}"/>
        </geometry>
        <material name="course_blue"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="${base_length} ${base_width} ${base_height}"/>
        </geometry>
      </collision>
      <inertial>
        <!-- 质心略向后，位于驱动轮轴与后支撑点之间。 -->
        <origin xyz="-0.04 0 0" rpy="0 0 0"/>
        <mass value="5.0"/>
        <inertia ixx="0.0708" ixy="0.0" ixz="0.0"
                 iyy="0.1367" iyz="0.0" izz="0.1862"/>
      </inertial>
    </link>
    <joint name="base_footprint_joint" type="fixed">
      <parent link="base_footprint"/>
      <child link="base_link"/>
      <origin xyz="0 0 ${base_link_z}" rpy="0 0 0"/>
    </joint>
  </xacro:macro>
</robot>
