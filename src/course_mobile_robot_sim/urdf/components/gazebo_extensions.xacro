<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Gazebo 专属表面、传感器和系统插件集中在本文件。 -->
  <xacro:macro name="gazebo_extensions" params="">
    <gazebo reference="left_wheel_link">
      <mu1>1.2</mu1>
      <mu2>1.2</mu2>
    </gazebo>
    <gazebo reference="right_wheel_link">
      <mu1>1.2</mu1>
      <mu2>1.2</mu2>
    </gazebo>
    <gazebo reference="caster_link">
      <mu1>0.05</mu1>
      <mu2>0.05</mu2>
    </gazebo>

    <gazebo reference="lidar_link">
      <sensor name="course_lidar" type="gpu_lidar">
        <pose>0 0 0 0 0 0</pose>
        <topic>/scan</topic>
        <gz_frame_id>lidar_link</gz_frame_id>
        <!-- 提高扫描频率，减小机器人转弯时相邻两帧之间的角度变化。 -->
        <update_rate>20</update_rate>
        <always_on>true</always_on>
        <visualize>true</visualize>
        <lidar>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.1415926</min_angle>
              <max_angle>3.1415926</max_angle>
            </horizontal>
            <vertical>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.08</min>
            <max>8.0</max>
            <resolution>0.01</resolution>
          </range>
        </lidar>
      </sensor>
    </gazebo>

    <gazebo>
      <plugin filename="gz-sim-diff-drive-system"
              name="gz::sim::systems::DiffDrive">
        <left_joint>left_wheel_joint</left_joint>
        <right_joint>right_wheel_joint</right_joint>
        <wheel_separation>${2.0 * wheel_y}</wheel_separation>
        <wheel_radius>${wheel_radius}</wheel_radius>
        <topic>/cmd_vel</topic>
        <odom_topic>/odom</odom_topic>
        <tf_topic>/tf</tf_topic>
        <frame_id>odom</frame_id>
        <child_frame_id>base_footprint</child_frame_id>
        <odom_publish_frequency>30</odom_publish_frequency>
        <max_linear_acceleration>0.35</max_linear_acceleration>
        <min_linear_acceleration>-0.35</min_linear_acceleration>
        <min_angular_acceleration>-1.0</min_angular_acceleration>
        <max_angular_acceleration>1.0</max_angular_acceleration>
      </plugin>

      <plugin filename="gz-sim-joint-state-publisher-system"
              name="gz::sim::systems::JointStatePublisher">
        <topic>/joint_states</topic>
        <joint_name>left_wheel_joint</joint_name>
        <joint_name>right_wheel_joint</joint_name>
      </plugin>
    </gazebo>
  </xacro:macro>
</robot>
