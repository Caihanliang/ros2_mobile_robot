<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- 所有组件共用的尺寸参数，单位为米。 -->
  <xacro:property name="base_length" value="0.55"/>
  <xacro:property name="base_width" value="0.38"/>
  <xacro:property name="base_height" value="0.16"/>
  <xacro:property name="base_link_z" value="0.16"/>
  <xacro:property name="wheel_radius" value="0.10"/>
  <xacro:property name="wheel_width" value="0.06"/>
  <xacro:property name="wheel_marker_width" value="0.07"/>
  <xacro:property name="wheel_x" value="0.08"/>
  <xacro:property name="wheel_y" value="0.22"/>
  <xacro:property name="wheel_z" value="${wheel_radius - base_link_z}"/>
  <xacro:property name="caster_radius" value="0.05"/>
  <xacro:property name="caster_x" value="-0.24"/>
  <xacro:property name="caster_z" value="${caster_radius - base_link_z}"/>
  <xacro:property name="lidar_x" value="0.16"/>
  <xacro:property name="lidar_support_radius" value="0.025"/>
  <xacro:property name="lidar_support_length" value="0.08"/>
  <xacro:property name="lidar_support_z" value="0.12"/>
  <xacro:property name="lidar_z_from_support" value="0.06"/>
  <xacro:property name="lidar_radius" value="0.065"/>
  <xacro:property name="lidar_height" value="0.055"/>
</robot>
